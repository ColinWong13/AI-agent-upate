# ── Database ──
# USE_SQLITE=true 时使用 SQLite（零依赖），=false 时使用下面配置的 PostgreSQL
USE_SQLITE=true
DATABASE_URL=postgresql+asyncpg://aiagent:aiagent123@localhost:5432/ai_agent_platform
DATABASE_URL_SYNC=postgresql+psycopg2://aiagent:aiagent123@localhost:5432/ai_agent_platform

# ── Redis（可选）──
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
JWT_SECRET=change-this-in-production

# ── LLM ──
# provider: ollama（本地）或 openai（兼容 API）
LLM_PROVIDER=ollama
# Ollama 默认地址
LLM_BASE_URL=http://localhost:11434
# 推荐模型（需先 ollama pull qwen2.5:7b）
LLM_MODEL=qwen2.5:7b
# OpenAI 兼容 API 时才需要
LLM_API_KEY=

# ── Crawler ──
# 新闻 RSS 爬取间隔（小时）
CRAWL_INTERVAL_HOURS=6
